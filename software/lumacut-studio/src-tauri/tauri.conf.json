{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LumaCut Studio",
  "version": "0.4.0",
  "identifier": "de.millione.lumacut.studio",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LumaCut Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 950,
        "minHeight": 650,
        "backgroundColor": "#0b0e13"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
