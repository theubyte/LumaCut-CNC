#version 440
// Instant image preview on the GPU: grey, contrast and brightness as adjustGray() on the CPU, then one of threshold,
// ordered dither, or edge strength as a preliminary step for vectorising. Error diffusion is serial and stays on the CPU.
layout(local_size_x = 32, local_size_y = 32) in;   // D3D11 allows at most 1024 per group
layout(rgba8, binding = 1) readonly uniform image2D src;
layout(rgba8, binding = 2) writeonly uniform image2D dst;
layout(std140, binding = 0) uniform Params {
    float factor;      // (100 + contrast) / 100
    float shift;       // brightness * 2.55
    float threshold;   // 0..255
    int invert;
    int mode;          // 0 grey, 1 threshold, 2 ordered, 3 edges
};
const int bayer[64] = int[64](
     0, 48, 12, 60,  3, 51, 15, 63,
    32, 16, 44, 28, 35, 19, 47, 31,
     8, 56,  4, 52, 11, 59,  7, 55,
    40, 24, 36, 20, 43, 27, 39, 23,
     2, 50, 14, 62,  1, 49, 13, 61,
    34, 18, 46, 30, 33, 17, 45, 29,
    10, 58,  6, 54,  9, 57,  5, 53,
    42, 26, 38, 22, 41, 25, 37, 21);

float grey(ivec2 p) {
    vec4 c = floor(imageLoad(src, p) * 255.0 + 0.5);    // whole levels, exactly as on the CPU
    float a = c.a / 255.0;
    float l = 0.2126 * c.r + 0.7152 * c.g + 0.0722 * c.b;
    float g = floor(l * a + 255.0 * (1.0 - a) + 0.5);     // transparent counts as white: no laser
    float x = clamp((g - 128.0) * factor + 128.0 + shift, 0.0, 255.0);
    x = invert != 0 ? 255.0 - x : x;
    return floor(x + 0.5);
}
void main() {
    ivec2 size = imageSize(src);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y) return;
    float v;
    if (mode == 3) {
        ivec2 m = size - ivec2(1);
        float tl = grey(clamp(p + ivec2(-1, -1), ivec2(0), m)), t = grey(clamp(p + ivec2(0, -1), ivec2(0), m)), tr = grey(clamp(p + ivec2(1, -1), ivec2(0), m));
        float l  = grey(clamp(p + ivec2(-1,  0), ivec2(0), m)),                                                  r = grey(clamp(p + ivec2(1,  0), ivec2(0), m));
        float bl = grey(clamp(p + ivec2(-1,  1), ivec2(0), m)), b = grey(clamp(p + ivec2(0,  1), ivec2(0), m)), br = grey(clamp(p + ivec2(1,  1), ivec2(0), m));
        float gx = (tr + 2.0 * r + br) - (tl + 2.0 * l + bl);
        float gy = (bl + 2.0 * b + br) - (tl + 2.0 * t + tr);
        v = 255.0 - floor(min(255.0, sqrt(gx * gx + gy * gy) * 0.25) + 0.5);   // dark edges on white
    } else {
        v = grey(p);
        if (mode == 1) v = v < threshold ? 0.0 : 255.0;
        else if (mode == 2) v = v < (float(bayer[(p.y & 7) * 8 + (p.x & 7)]) + 0.5) * 255.0 / 64.0 ? 0.0 : 255.0;
    }
    imageStore(dst, p, vec4(vec3(v / 255.0), 1.0));
}
