[Unit]
Description=LumaCut CNC Pi 400: Marlin USB gateway, web UI and TCP 23
After=network-online.target
Wants=network-online.target
# Never give up restarting: the machine has no other control.
StartLimitIntervalSec=0

[Service]
Type=simple
User=lumacut
Group=lumacut
SupplementaryGroups=dialout video render
WorkingDirectory=/opt/lumacut
EnvironmentFile=/etc/lumacut/lumacut.env
EnvironmentFile=-/etc/lumacut/lumacut-marlin-port.env
Environment=PYTHONPATH=/opt/lumacut/pi400
ExecStart=/usr/bin/python3 -m marlin.web
Restart=always
RestartSec=3
TimeoutStopSec=15
# Out of memory (large uploads, ffmpeg): the gateway that can switch the laser off dies last.
OOMScoreAdjust=-500
NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
# /etc/lumacut: camera_calibration.json (machine calibration, see camera_calibration.py)
ReadWritePaths=/var/lib/lumacut -/etc/lumacut
ProtectHome=true
PrivateTmp=true
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Deliberately not: PrivateDevices, ProtectClock, DevicePolicy (they close /dev:
# SKR, panel and camera), ProtectKernelTunables (pyserial/GPIO read and use /sys).

[Install]
WantedBy=multi-user.target
